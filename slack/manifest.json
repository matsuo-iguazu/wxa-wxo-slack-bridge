{
    "display_information": {
        "name": "wxa-wxo-agent"
    },
    "features": {
        "bot_user": {
            "display_name": "wxa-wxo-agent",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write",
                "im:history",
                "groups:history",
                "app_mentions:read",
                "channels:history"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "request_url": "[YOUR_CODE_ENGINE_URL]/slack/events",
            "bot_events": [
                "app_mention",
                "message.channels",
                "message.im"
            ]
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false
    }
}
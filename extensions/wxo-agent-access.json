{
  "openapi": "3.0.1",
  "info": {
    "title": "watsonx Orchestrate Extension",
    "description": "wxOエージェントへのメッセージ送信とレスポンス取得。リージョンとインスタンスIDを設定可能。",
    "version": "1.2.0"
  },
  "servers": [
    {
      "url": "https://api.{region}.watson-orchestrate.cloud.ibm.com/instances/{instanceid}/v1/orchestrate",
      "variables": {
        "region": {
          "default": "us-south",
          "description": "wxOのリージョン（例: us-south, jp-tok, eu-de, eu-gb）。サービス・インスタンスURLの「api.」と「.watson-orchestrate」の間の部分です。"
        },
        "instanceid": {
          "default": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
          "description": "wxOインスタンスID（UUID形式、ハイフンあり）。サービス・インスタンスURLの「/instances/」以降の部分です。\n\n例: https://api.us-south.watson-orchestrate.cloud.ibm.com/instances/aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee\n→ region: us-south\n→ instanceid: aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
        }
      }
    }
  ],
  "paths": {
    "/runs": {
      "post": {
        "operationId": "run_agent",
        "summary": "エージェントにメッセージを送信（新規・継続両対応）",
        "parameters": [
          { "name": "Authorization", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agent_id": { "type": "string" },
                  "thread_id": { "type": "string", "description": "継続の場合は前回のthread_idを指定" },
                  "message": {
                    "type": "object",
                    "properties": {
                      "role": { "type": "string", "default": "user" },
                      "content": { "type": "string" }
                    },
                    "required": ["role", "content"]
                  }
                },
                "required": ["agent_id", "message"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "thread_id": { "type": "string" },
                    "run_id": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/threads/{thread_id}/messages": {
      "get": {
        "operationId": "list_messages",
        "summary": "スレッドからメッセージ履歴を取得",
        "parameters": [
          { "name": "thread_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "Authorization", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": { "type": "string" },
                      "content": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "text": { "type": "string" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}